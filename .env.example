# LLM Backend — set MOCK_LLM=true to test without a real API key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-placeholder
LLM_MODEL=gpt-3.5-turbo
MOCK_LLM=true

# Cache
CACHE_DB_PATH=cache.db
CACHE_TTL_SECONDS=3600

# Similarity threshold — cosine similarity floor for semantic cache hits.
# Higher = stricter matching (fewer hits, fewer false positives).
# Lower  = looser matching (more hits, risk of wrong cached answers).
# Default 0.85 is a reasonable starting point for BGE-small.
SIMILARITY_THRESHOLD=0.85

# Warn once per process when the O(n) semantic scan compares against more
# than this many cached entries (see docs/TECHNICAL_DETAIL.md Known limitations).
MAX_SEMANTIC_SCAN_ENTRIES=5000

# Admin — set to a strong random value in any real deployment.
# When empty, /cache/purge, /eval/threshold-sweep and /dashboard are
# unauthenticated (fine for local mock-mode demos only).
ADMIN_TOKEN=

# Server
HOST=127.0.0.1
PORT=8000